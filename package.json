{
    "name": "hexo-next-publist",
    "version": "3.0.0",
    "description": "Filterable publication list",
    "author": "Aetf",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Aetf/hexo-next-publist.git"
    },
    "bugs": {
        "url": "https://github.com/Aetf/hexo-next-publist/issues"
    },
    "homepage": "https://github.com/Aetf/hexo-next-publist",
    "keywords": [
        "hexo",
        "publication",
        "academia"
    ],
    "type": "module",
    "main": "index.cjs",
    "files": [
        "bib-wasm/LICENSE.MIT-bibtex-parser",
        "CHANGELOG.md",
        "index.cjs",
        "bridge.cjs",
        "dist/",
        "templates/",
        "widget/",
        "bib-wasm/pkg/"
    ],
    "scripts": {
        "eslint": "eslint .",
        "build:wasm": "wasm-pack build bib-wasm --target nodejs --release --out-dir pkg && rm -f bib-wasm/pkg/.gitignore",
