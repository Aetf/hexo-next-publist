        "pretest": "npm run build",
        "test": "ava",
        "test-watch": "ava --watch",
        "build:ts": "tsc",
        "build": "npm run build:wasm && npm run build:ts"
    },
    "dependencies": {
        "@babel/core": "^7.13.13",
        "@babel/preset-env": "^7.13.12",
        "@primer/css": "^17.11.0",
        "babel-loader": "^10.0.0",
        "chalk": "^6.0.0",
        "clipboard": "^2.0.8",
        "core-js": "^3.9.1",
        "css-loader": "^7.0.0",
        "cssnano": "^8.0.0",
        "cssnano-preset-advanced": "^8.0.0",
        "hexo-fs": "^5.0.0",
        "lodash": "^4.17.21",
        "memfs": "^4.0.0",
        "mini-css-extract-plugin": "^2.3.0",
        "postcss": "^8.2.8",
        "postcss-loader": "^8.0.0",
        "sass": "^1.34.0",
        "sass-loader": "^13.0.0",
        "strip-indent": "^4.1.1",
        "style-loader": "^3.3.0",
        "verror": "^1.10.0",
        "webpack": "^5.28.0"
