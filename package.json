        "globals": "^17.11.0",
        "hexo": "^8.0.0",
        "hexo-renderer-marked": "^7.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "wasm-pack": "^0.15.0"
